# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.
#
# Used by the Vercel serverless functions (api/state.js, api/picks.js, api/admins.js).
# For local testing with the API: run `vercel dev` instead of `npm run dev`.
# `npm run dev` (Vite only) skips the API and uses localStorage + src/data/admins.js as fallback.

JSONBIN_API_KEY=$2b$10$your_master_key_here

# Bin for bag state (persons + current pick)
# Initialize with: { "persons": [], "lastPick": null }
JSONBIN_STATE_BIN_ID=your_state_bin_id_here

# Bin for pick history (log)
# Initialize with: { "log": [] }
JSONBIN_HISTORY_BIN_ID=your_history_bin_id_here

# Bin for admins (read-only from the app — manage directly in JSONBin)
# Initialize with: { "admins": [ { "name": "Alice", "hash": "<md5 of code>" } ] }
JSONBIN_ADMINS_BIN_ID=your_admins_bin_id_here
